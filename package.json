{
  "name": "memberful-wp",
  "version": "1.78.1",
  "description": "Better membership software for WordPress.",
  "main": "js/index.js",
  "scripts": {
    "start": "wp-scripts start --source-path=js/src --output-path=js/build",
    "build": "wp-scripts build --source-path=js/src --output-path=js/build",
    "check-engines": "wp-scripts check-engines",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:destroy": "wp-env destroy",
    "env:update": "wp-env start --update",
    "env:cli": "wp-env run cli wp",
    "env:logs": "wp-env logs",
    "env:status": "wp-env status",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+git@github.com:memberful/memberful-wp.git"
  },
  "author": "Memberful",
  "license": "ISC",
  "keywords": [
    "wordpress",
    "membership",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/memberful/memberful-wp/issues"
  },
  "homepage": "https://github.com/memberful/memberful-wp#readme",
  "lint-staged": {
    "*.php": "vendor/bin/phpcs-changed --git --standard phpcs.xml -s --warning-severity 0"
  },
  "devDependencies": {
    "@wordpress/env": "^11.14.0",
    "@wordpress/scripts": "^34.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
