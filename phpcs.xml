<?xml version="1.0"?>
<ruleset name="Memberful WP">
  <description>Memberful WP project ruleset</description>

  <!-- Files or directories to check -->
  <file>.</file>

  <!-- Only first-party plugin PHP; never lint dependencies or build output. -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/js/*</exclude-pattern>
  <exclude-pattern>*/wordpress/*</exclude-pattern>
  <exclude-pattern>*/.wordpress-org/*</exclude-pattern>

  <arg name="extensions" value="php"/>

  <!-- Minimum supported PHP for PHPCompatibility; mirrors "Requires PHP: 7.4". -->
  <config name="testVersion" value="7.4-" />

  <!-- Flag code that breaks on a supported PHP version (whitelists WP core polyfills). -->
  <rule ref="PHPCompatibilityWP"/>

  <!-- Include WordPress Ruleset -->
  <rule ref="WordPress">
    <!-- Exclude some specific rules -->
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent" />
    <exclude name="Generic.WhiteSpace.ScopeIndent.Incorrect" />
    <exclude name="Generic.WhiteSpace.ScopeIndent.IncorrectExact" />
    <exclude name="Universal.WhiteSpace.PrecisionAlignment.Found" />
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent.SpacesUsed" />
    <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing" />
    <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
  </rule>

  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="2"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>

  <rule ref="Generic.WhiteSpace.DisallowTabIndent" />
</ruleset>
